#include "Version.xcconfig"

// Sparkle EdDSA *public* key (safe to commit). The private key lives only in the
// release machine's keychain / the SPARKLE_PRIVATE_KEY CI secret.
SPARKLE_PUBLIC_ED_KEY = NWiV3T1PZqRuzEziIn90bYWkMH1/cqp2YcPAAmaPOc4=

// Local builds are ad-hoc signed. Release signing happens in Scripts/sign.sh
// with a Developer ID Application identity, inside-out, after the build.
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none

// Optional, git-ignored per-developer overrides.
#include? "Local.xcconfig"
