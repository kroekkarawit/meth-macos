<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.kroekkarawit.Meth.Helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/MethHelper</string>
	<key>MachServices</key>
	<dict>
		<key>io.github.kroekkarawit.Meth.Helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.kroekkarawit.Meth</string>
	</array>
	<!-- Run at boot to restore any `disablesleep` left by a session from a previous boot. -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after a crash so deadlines and leases are always enforced. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
