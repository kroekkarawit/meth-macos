    "Meth will link the `meth` command into %@ for your account. You can also install it for all users in /usr/local/bin (requires an administrator password).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meth will link the `meth` command into %@ for your account. You can also install it for all users in /usr/local/bin (requires an administrator password)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Meth จะสร้างลิงก์คำสั่ง `meth` ไว้ที่ %@ สำหรับบัญชีของคุณ หรือจะติดตั้งให้ผู้ใช้ทุกคนที่ /usr/local/bin ก็ได้ (ต้องใช้รหัสผ่านผู้ดูแลระบบ)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Meth 会将 `meth` 命令链接到 %@（仅限你的账户）。你也可以为所有用户安装到 /usr/local/bin（需要管理员密码）。"
          }
        }
      }
    },
    "Meth’s background controller is not running. If you turned Meth off in System Settings › General › Login Items, turn it back on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meth’s background controller is not running. If you turned Meth off in System Settings › General › Login Items, turn it back on."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมเบื้องหลังของ Meth ไม่ได้ทำงาน ถ้าคุณปิด Meth ไว้ใน การตั้งค่าระบบ › ทั่วไป › รายการล็อกอิน ให้เปิดกลับมา"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Meth 的后台控制器未运行。如果你在“系统设置 › 通用 › 登录项”中关闭了 Meth，请重新打开。"
          }
        }
      }
    },
