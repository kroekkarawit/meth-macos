  "sourceLanguage": "en",
  "strings": {
    "%@ already exists and is not Meth’s command line tool. Meth will not overwrite it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists and is not Meth’s command line tool. Meth will not overwrite it."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วและไม่ใช่เครื่องมือบรรทัดคำสั่งของ Meth จึงจะไม่เขียนทับ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在，且不是 Meth 的命令行工具。Meth 不会覆盖它。"
          }
        }
      }
    },
