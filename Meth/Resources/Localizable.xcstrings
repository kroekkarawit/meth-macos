    "Allow Meth in System Settings › General › Login Items to use Overdose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Meth in System Settings › General › Login Items to use Overdose."
