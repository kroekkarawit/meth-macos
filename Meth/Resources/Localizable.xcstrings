        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะใช้ Overdose ไม่ได้จนกว่าจะเปิดใช้ตัวช่วยอีกครั้ง ส่วน Bump และ High ยังใช้ได้ตามปกติ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新启用助手之前将无法使用 Overdose。Bump 和 High 仍可正常使用。"
          }
        }
      }
    },
