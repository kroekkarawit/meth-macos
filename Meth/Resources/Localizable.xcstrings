        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาต Meth ใน การตั้งค่าระบบ › ทั่วไป › รายการล็อกอิน เพื่อใช้ Overdose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 通用 › 登录项”中允许 Meth 以使用 Overdose。"
          }
        }
      }
    },
